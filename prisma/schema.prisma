generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Zoo {
  id        Int      @id @default(autoincrement())
  nombre    String
  pais      String
  hectareas Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  animales  Animal[]

  @@map("zoos")
}

model Animal {
  id        Int      @id @default(autoincrement())
  nombre    String
  especie   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  zoo       Zoo?     @relation(fields: [zooId], references: [id])
  zooId     Int?

  @@map("animales")
}
